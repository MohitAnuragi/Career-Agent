# Copy to .env and fill in.

# Postgres with the pgvector extension (docker-compose, Supabase and Neon all work)
DATABASE_URL=postgresql://career:career@localhost:5432/career_agent

# Google AI Studio key: https://aistudio.google.com/apikey  (free tier is enough for a demo)
GEMINI_API_KEY=
# Lite models are fast and stay available on the free tier when the big flash models return 503 "high demand"
GEMINI_MODEL=gemini-3.1-flash-lite
# Evals only: a different (newer) model grades relevance so the reranker isn't grading itself
JUDGE_MODEL=gemini-3.5-flash-lite

# "gemini" for real calls, "fake" to run the app and tests offline without a key
LLM_PROVIDER=gemini

# Local embedding model (ONNX via fastembed, no API cost). The Docker image pre-downloads it.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Per-user cap on LLM-backed requests per day (cost control)
DAILY_LLM_LIMIT=40
# Cap across all users per day. Anonymous sign-up is free, so this protects the free-tier quota on a public URL.
GLOBAL_DAILY_LLM_LIMIT=800

# Required to call POST /admin/ingest. Leave empty to disable the endpoint.
ADMIN_TOKEN=
